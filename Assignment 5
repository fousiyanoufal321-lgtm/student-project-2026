# Generator function for even numbers
def even_numbers(n):
    for i in range(1,n+1):
      yield i * 2


# Using the generator
print ("First 5 even numbers:")
for num in even_numbers(5):
    print(num)

# Decorator function
def greet(func):
  def wrapper("args,**kwargs):
    print("hello!")
    return func("args,**kwargs)
  return wrapper

# Function with decorator
@greet
def introduce(name):
   print(f"My name is {name}")

# Calling the function
introduce ("Alice")

